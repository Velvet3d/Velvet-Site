@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="scene-code-panel @(isOpen ? "open" : string.Empty)">
    @if (!string.IsNullOrWhiteSpace(HintText))
    {
        <div class="scene-code-hint">@HintText</div>
    }

    <button type="button"
            class="scene-code-toggle"
            @onclick="TogglePanel"
            aria-expanded="@isOpen"
            aria-label="@(isOpen ? "Hide code" : "Show code")">
        <span class="scene-code-toggle-icon" aria-hidden="true">@(isOpen ? "×" : "</>")</span>
    </button>

    @if (isOpen)
    {
        <section class="scene-code-sheet" aria-hidden="false">
            <div class="scene-code-header" role="tablist" aria-label="Code tabs">
                <div class="scene-code-tab-group">
                    <a href="#"
                       class="scene-code-tab @(activeTab == CodeTab.Blazor ? "active" : string.Empty)"
                       role="tab"
                       aria-selected="@(activeTab == CodeTab.Blazor)"
                       @onclick="() => SetTab(CodeTab.Blazor)"
                       @onclick:preventDefault="true">
                        Blazor
                    </a>

                    @if (!string.IsNullOrWhiteSpace(BlazorHref))
                    {
                        <a class="scene-code-tab-link"
                           href="@BlazorHref"
                           target="_blank"
                           rel="noreferrer"
                           aria-label="Open Blazor link">
                            ↗
                        </a>
                    }
                </div>

                <div class="scene-code-tab-group">
                    <a href="#"
                       class="scene-code-tab @(activeTab == CodeTab.Razor ? "active" : string.Empty)"
                       role="tab"
                       aria-selected="@(activeTab == CodeTab.Razor)"
                       @onclick="() => SetTab(CodeTab.Razor)"
                       @onclick:preventDefault="true">
                        Razor (SSR)
                    </a>

                    @if (!string.IsNullOrWhiteSpace(RazorHref))
                    {
                        <a class="scene-code-tab-link"
                           href="@RazorHref"
                           target="_blank"
                           rel="noreferrer"
                           aria-label="Open Razor link">
                            ↗
                        </a>
                    }
                </div>

                <button type="button" class="scene-code-copy" @onclick="CopyCurrentTabAsync">
                    @copyLabel
                </button>
            </div>

            <pre class="scene-code-block"><code>@CurrentCode</code></pre>
        </section>
    }
</div>

@code {
    [Parameter] public string BlazorCode { get; set; } = string.Empty;
    [Parameter] public string RazorCode { get; set; } = string.Empty;
    [Parameter] public string? HintText { get; set; }
    [Parameter] public string? BlazorHref { get; set; }
    [Parameter] public string? RazorHref { get; set; }

    private enum CodeTab
    {
        Blazor,
        Razor
    }

    private bool isOpen;
    private string copyLabel = "Copy";
    private CodeTab activeTab = CodeTab.Blazor;

    private string CurrentCode => activeTab == CodeTab.Blazor ? BlazorCode : RazorCode;

    private void TogglePanel()
    {
        isOpen = !isOpen;
        copyLabel = "Copy";
    }

    private void SetTab(CodeTab tab)
    {
        activeTab = tab;
        copyLabel = "Copy";
    }

    private async Task CopyCurrentTabAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", CurrentCode);
            copyLabel = "Copied";
        }
        catch
        {
            copyLabel = "Copy failed";
        }

        await Task.Delay(1200);
        copyLabel = "Copy";
        await InvokeAsync(StateHasChanged);
    }
}
