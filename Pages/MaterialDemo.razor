@page "/material-demo"

<div class="material-demo-page">
    <canvas @ref="canvasRef"
            class="material-demo-canvas"></canvas>

    <div class="debug-panel">
        <h3 class="debug-title">Material Demo</h3>
        <p class="demo-description">Three Suzanne models showcasing different material properties</p>
        
        <div class="debug-section">
            <h4>Directional Light</h4>
            <label>
                <input type="checkbox" @bind="directionalEnabled" @bind:event="oninput" /> Enabled
            </label>
            <label>
                Intensity: <input type="range" min="0" max="3" step="0.1" @bind="directionalIntensity" @bind:event="oninput" />
                <span>@directionalIntensity.ToString("F1")</span>
            </label>
            <label>
                Color:
                <input type="color" @bind="directionalColor" @bind:event="oninput" />
            </label>
        </div>

        <div class="debug-section">
            <h4>Point Light</h4>
            <label>
                <input type="checkbox" @bind="pointEnabled" @bind:event="oninput" /> Enabled
            </label>
            <label>
                Intensity: <input type="range" min="0" max="5" step="0.1" @bind="pointIntensity" @bind:event="oninput" />
                <span>@pointIntensity.ToString("F1")</span>
            </label>
            <label>
                Color:
                <input type="color" @bind="pointColor" @bind:event="oninput" />
            </label>
        </div>

        <div class="debug-section">
            <h4>Materials</h4>
            <div class="material-info">
                <div class="material-item">
                    <span class="material-color" style="background-color: #ff6b6b;"></span>
                    <span>Matte (Red) - Low ambient, standard diffuse</span>
                </div>
                <div class="material-item">
                    <span class="material-color" style="background-color: #4ecdc4;"></span>
                    <span>Standard (Cyan) - Balanced lighting</span>
                </div>
                <div class="material-item">
                    <span class="material-color" style="background-color: #ffe66d;"></span>
                    <span>Bright (Yellow) - High ambient and diffuse</span>
                </div>
            </div>
        </div>

        <div class="debug-section">
            <h4>Camera Controls</h4>
            <p>🖱️ Drag to rotate</p>
            <p>🔍 Scroll to zoom</p>
        </div>
    </div>
</div>
