@page "/custom-material-demo"

<div class="custom-material-page">
    <canvas @ref="canvasRef"
            class="custom-material-canvas"></canvas>

    <div class="debug-panel">
        <h3 class="debug-title">Custom Material System Demo</h3>
        <p class="demo-description">Demonstrates the new Material class with custom shader uniforms</p>
        
        <div class="debug-section">
            <h4>Custom Material Properties</h4>
            <label>
                Color R: <input type="range" min="0" max="1" step="0.01" @bind="colorR" @bind:event="oninput" />
                <span>@colorR.ToString("F2")</span>
            </label>
            <label>
                Color G: <input type="range" min="0" max="1" step="0.01" @bind="colorG" @bind:event="oninput" />
                <span>@colorG.ToString("F2")</span>
            </label>
            <label>
                Color B: <input type="range" min="0" max="1" step="0.01" @bind="colorB" @bind:event="oninput" />
                <span>@colorB.ToString("F2")</span>
            </label>
            <label>
                Metallic: <input type="range" min="0" max="1" step="0.01" @bind="metallic" @bind:event="oninput" />
                <span>@metallic.ToString("F2")</span>
            </label>
        </div>
    </div>
      <SceneCodeViewer BlazorCode="@BlazorCode"
                     RazorCode="@RazorCode"
                     BlazorHref="/scene2?view=blazor"
                     RazorHref="/scene2?view=razor" />
                     
</div>
