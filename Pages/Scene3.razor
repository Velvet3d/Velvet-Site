@page "/scene3"

<PageTitle>Lighting Showcase - Velvet</PageTitle>

<div class="scene3-page">
    <canvas @ref="canvasRef" class="scene3-canvas"></canvas>

    <div class="scene3-panel">

        <h2>Lighting Controls</h2>

        <div class="light-block">
            <h4>Directional</h4>
            <label> <input type="checkbox" @bind="directionalEnabled" /> Enabled</label>
            <input type="range" min="0" max="5" step="0.1" @bind="directionalIntensity"
                                         @bind:event="oninput" /> 
                <input type="color" @bind="directionalColor" />
            </div>

            <div class="light-block">
                <h4>Point</h4>
                <label><input type="checkbox" @bind="pointEnabled" /> Enabled </label>
               <input type="range" min="0" max="5" step="0.1" @bind="pointIntensity"
                                            @bind:event="oninput" />
                    <input type="color" @bind="pointColor" />
                </div>

                <div class="light-block">
                    <h4>Spot</h4>
                    <label><input type="checkbox" @bind="spotEnabled" /> Enabled </label>
                   <input type="range" min="0" max="5" step="0.1" @bind="spotIntensity"
                                                @bind:event="oninput" /> 
                        <input type="color" @bind="spotColor" />
                    </div>

                </div>
                <SceneCodeViewer BlazorCode="@BlazorCode" RazorCode="@RazorCode" HintText="Blazor + Razor snippets" />
            </div>