@page "/scene3"

<div class="scene3-page">
    <canvas @ref="canvasRef"
            class="scene3-canvas"></canvas>

    <div class="debug-panel">
        <h3 class="debug-title">Scene 3: Cube & Sphere Demo</h3>
        
        <div class="debug-section">
            <h4>Directional Light</h4>
            <label>
                <input type="checkbox" @bind="directionalEnabled" @bind:event="oninput" /> Enabled
            </label>
            <label>
                Intensity: <input type="range" min="0" max="3" step="0.1" @bind="directionalIntensity" @bind:event="oninput" />
                <span>@directionalIntensity.ToString("F1")</span>
            </label>
            <label>
                Color:
                <input type="color" @bind="directionalColor" @bind:event="oninput" />
            </label>
        </div>

        <div class="debug-section">
            <h4>Point Light</h4>
            <label>
                <input type="checkbox" @bind="pointEnabled" @bind:event="oninput" /> Enabled
            </label>
            <label>
                Intensity: <input type="range" min="0" max="5" step="0.1" @bind="pointIntensity" @bind:event="oninput" />
                <span>@pointIntensity.ToString("F1")</span>
            </label>
            <label>
                Color:
                <input type="color" @bind="pointColor" @bind:event="oninput" />
            </label>
            <label>
                Position Y: <input type="range" min="-3" max="3" step="0.1" @bind="pointPosY" @bind:event="oninput" />
                <span>@pointPosY.ToString("F1")</span>
            </label>
        </div>

        <div class="debug-section">
            <h4>Spot Light</h4>
            <label>
                <input type="checkbox" @bind="spotEnabled" @bind:event="oninput" /> Enabled
            </label>
            <label>
                Intensity: <input type="range" min="0" max="10" step="0.5" @bind="spotIntensity" @bind:event="oninput" />
                <span>@spotIntensity.ToString("F1")</span>
            </label>
            <label>
                Color:
                <input type="color" @bind="spotColor" @bind:event="oninput" />
            </label>
        </div>
    </div>
</div>
