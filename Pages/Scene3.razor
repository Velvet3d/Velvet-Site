@page "/scene3"

<PageTitle>Lighting Showcase - Velvet</PageTitle>

<div class="scene3-page">
    <canvas @ref="canvasRef" class="scene3-canvas"></canvas>

    <div class="scene3-panel" role="toolbar" aria-label="Lighting showcase controls">
        <div class="scene3-panel-header">
            <h2>Lighting Showcase</h2>
            <p>@ActiveLightLabel</p>
        </div>

        <div class="scene3-light-list">
            <div class="scene3-light-row @(activeLight == LightKind.Directional ? "active" : string.Empty)">
                <button type="button" class="scene3-light-select" @onclick="() => SetActiveLight(LightKind.Directional)">
                    Directional
                </button>
                <label class="scene3-light-toggle">
                    <input type="checkbox" @bind="directionalEnabled" @bind:event="oninput" />
                    <span>@(directionalEnabled ? "ON" : "OFF")</span>
                </label>
            </div>

            <div class="scene3-light-row @(activeLight == LightKind.Point ? "active" : string.Empty)">
                <button type="button" class="scene3-light-select" @onclick="() => SetActiveLight(LightKind.Point)">
                    Point
                </button>
                <label class="scene3-light-toggle">
                    <input type="checkbox" @bind="pointEnabled" @bind:event="oninput" />
                    <span>@(pointEnabled ? "ON" : "OFF")</span>
                </label>
            </div>

            <div class="scene3-light-row @(activeLight == LightKind.Spot ? "active" : string.Empty)">
                <button type="button" class="scene3-light-select" @onclick="() => SetActiveLight(LightKind.Spot)">
                    Spot
                </button>
                <label class="scene3-light-toggle">
                    <input type="checkbox" @bind="spotEnabled" @bind:event="oninput" />
                    <span>@(spotEnabled ? "ON" : "OFF")</span>
                </label>
            </div>
        </div>

        <label class="scene3-intensity-control">
            <span>Intensity</span>
            <input type="range" min="0" max="10" step="0.1" @bind="ActiveLightIntensity" @bind:event="oninput" />
            <strong>@ActiveLightIntensity.ToString("F1")</strong>
        </label>
    </div>

    <SceneCodeViewer BlazorCode="@BlazorCode"
                     RazorCode="@RazorCode"
                     HintText="Blazor + Razor snippets" />
</div>
